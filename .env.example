# =========================================================================
# FRESHFLORA PLATFORM CONFIGURATION & CREDENTIALS
# =========================================================================

# 1. Server Configuration
PORT=5000
NODE_ENV=production
CORS_ORIGIN=*

# 2. Google Gemini 2.5 Flash API Key
# Obtain free from: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# 3. Supabase Live PostgreSQL Configuration
# Obtain from your Supabase Project Settings -> API: https://supabase.com/dashboard
SUPABASE_URL=https://your-project-id.supabase.co
# Use anon public key or service role key for full administrative bypass of RLS
SUPABASE_ANON_KEY=eyJhbGciOi...your_anon_or_service_role_key...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...optional_service_role_key...

# Note: The platform features dual-mode database support.
# If SUPABASE_URL is omitted or pending, the platform safely runs on its
# embedded high-performance relational store without crashing.
